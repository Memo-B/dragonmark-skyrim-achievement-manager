<Window x:Class="Dragonmark.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Dragonmark.App"
        Title="Dragonmark - Skyrim Achievement Manager" Icon="Branding/mark.png" Width="1440" Height="960" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}" Language="en-US">
  <Window.InputBindings><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/><KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}"/></Window.InputBindings>
  <Grid ClipToBounds="True">
    <local:NordicAtmosphere IsHitTestVisible="False"/>
    <Image Source="{Binding ThemeArtwork}" Stretch="UniformToFill" Opacity="0.18" IsHitTestVisible="False"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#E80B141D" BorderBrush="#64717A" BorderThickness="0,0,1,0">
        <DockPanel Margin="19,24,19,20">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
            <Image Source="Branding/mark.png" Width="65" Height="65" HorizontalAlignment="Center" AutomationProperties.Name="Original Dragonmark emblem"/>
            <TextBlock Text="DRAGONMARK" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" Margin="0,8,0,6"/>
            <TextBlock Text="SKYRIM ACHIEVEMENT MANAGER" FontSize="8" Foreground="{StaticResource Muted}" TextAlignment="Center"/>
            <Grid Margin="8,18,8,0"><Border Height="1" Background="#53616A"/><TextBlock Text="◇" Background="#0B141D" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" Padding="10,0" Margin="0,-8"/></Grid>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="THE ELDER SCROLLS V" FontSize="9" Foreground="{StaticResource Muted}" TextAlignment="Center"/>
            <TextBlock Text="SKYRIM" FontFamily="{StaticResource DisplayFont}" FontSize="27" TextAlignment="Center" Margin="0,3,0,3"/>
            <TextBlock Text="SPECIAL / ANNIVERSARY EDITION" FontSize="8" TextAlignment="Center" Foreground="{StaticResource Muted}"/>
            <Border BorderBrush="#415460" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,13,0,0"><TextBlock Text="{Binding ProductFooter}" FontSize="9" Foreground="{StaticResource Muted}" TextAlignment="Center"/></Border>
          </StackPanel>
          <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Page}" Background="Transparent" BorderThickness="0" Foreground="#D5E0E6" IsEnabled="{Binding Idle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Navigation">
            <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="11,11"><TextBlock Text="◇" Foreground="{StaticResource Gold}" Margin="0,0,12,0"/><TextBlock Text="{Binding}" FontSize="12"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="28,22,28,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Explore demo" Command="{Binding DemoCommand}" Style="{StaticResource QuietButton}"/><Button Content="Connect Steam" Command="{Binding ConnectCommand}" Style="{StaticResource QuietButton}" Margin="0" ToolTip="Read your authenticated Steam context. Changes always require confirmation."/></StackPanel>
          <StackPanel><TextBlock Text="{Binding Page}" Style="{StaticResource DisplayHeading}"/><TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="#CF132530" BorderBrush="#516778" BorderThickness="1" Padding="12,8" Margin="0,0,0,15">
          <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{StaticResource Frost}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding Mode}" Foreground="{StaticResource Gold}" FontSize="11"/></DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Panel}" Background="#A6152531" Margin="0,0,0,18" Padding="20,14" Visibility="{Binding IsDashboard, Converter={StaticResource BoolVisibility}}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="A CHRONICLE OF YOUR DEEDS" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Gold}"/><TextBlock Text="Leave your mark." FontFamily="{StaticResource DisplayFont}" FontSize="24" Margin="0,8,0,8"/><TextBlock Text="{Binding Recent}" Foreground="{StaticResource Muted}" FontSize="10" MaxHeight="30"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="22,0,24,0" VerticalAlignment="Center"><DockPanel><TextBlock Text="{Binding Completion, StringFormat={}{0:0.0}%}" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource Gold}" FontSize="30"/><TextBlock Text="{Binding Unlocked, StringFormat={}{0} unlocked}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10"/></DockPanel><ProgressBar Value="{Binding Completion, Mode=OneWay}" Maximum="100" Height="3" Margin="0,6,0,8"/><TextBlock Text="{Binding Delta}" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="◇  Unlock All" Command="{Binding UnlockAllCommand}" Style="{StaticResource PrimaryButton}" Margin="0" Padding="25,12" ToolTip="Preview every locked achievement. Search and selection do not restrict this action."/><TextBlock Text="{Binding Locked, StringFormat={}{0} locked · One confirmation}" FontSize="10" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,9,0,0"/></StackPanel>
          </Grid>
        </Border>
        <Grid x:Name="PageContent" Grid.Row="3">
          <Grid Visibility="{Binding IsCollection, Converter={StaticResource BoolVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,11" IsEnabled="{Binding Idle}">
              <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="10,0,0,0" Style="{StaticResource QuietButton}" ToolTip="Refresh Steam states (F5)"/>
              <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" Margin="10,0,0,0" AutomationProperties.Name="Sort achievements"/>
              <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Margin="10,0,0,0" AutomationProperties.Name="Filter achievements"/>
              <Grid><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search achievements" ToolTip="Search names, descriptions or API identifiers (Ctrl+F)"/><TextBlock Text="Search the collection…" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Unlock Missing" Command="{Binding UnlockAllCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsLockedPage, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding RaritySummary}" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="255"/></Grid.ColumnDefinitions>
              <ListBox x:Name="AchievementList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Detail}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Frost}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" IsEnabled="{Binding Idle}" Margin="0,0,15,0" AutomationProperties.Name="Achievement collection">
                <ListBox.ItemTemplate><DataTemplate>
                  <Border BorderBrush="{Binding Accent}" BorderThickness="2,0,0,0">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="#354A5260"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="79"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding Name}" ToolTip="Include this achievement in the next preview"/>
                      <Border Grid.Column="1" Width="67" Height="67" BorderBrush="{Binding Accent}" BorderThickness="1" Padding="4" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#09131C"><Grid><TextBlock Text="◇" FontSize="32" Foreground="#6D8593" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="{Binding ArtworkLabel}"/></Grid></Border>
                      <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="16"/><TextBlock Text="{Binding Description}" Foreground="#B4C3CD" FontSize="11" Margin="0,6,0,5"/><TextBlock Text="{Binding Date}" Foreground="#9AADB9" FontSize="9"/><TextBlock Text="{Binding ApiId}" Foreground="#8197A6" FontSize="8" Margin="0,4,0,0"/></StackPanel>
                      <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" FontSize="9" Foreground="{Binding Accent}" TextAlignment="Right" FontWeight="SemiBold"/><TextBlock Text="{Binding Rarity}" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,7,0,5" TextAlignment="Right"/><TextBlock Text="◇ RARE" FontSize="9" Foreground="#C5DCE6" HorizontalAlignment="Right" Visibility="{Binding Rare, Converter={StaticResource BoolVisibility}}"/><Button Content="Preview unlock" Command="{Binding PreviewCommand}" Style="{StaticResource QuietButton}" FontSize="9" Padding="6,5" Margin="0,6,0,0" MinHeight="26" Visibility="{Binding CanUnlock, Converter={StaticResource BoolVisibility}}"/></StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Border Margin="0,0,15,0" Style="{StaticResource Panel}" Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}"><StackPanel VerticalAlignment="Center"><TextBlock Text="◇" FontSize="45" Foreground="{StaticResource Gold}" HorizontalAlignment="Center"/><TextBlock Text="{Binding EmptyText}" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="18" Background="#DC0F1C27"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <TextBlock Text="THE MARK · DETAILS" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Gold}" Margin="0,0,0,17"/>
                <TextBlock Text="Select an entry to inspect its artwork and recorded state." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,15"/>
                <StackPanel Visibility="{Binding HasDetail, Converter={StaticResource BoolVisibility}}">
                  <Border Width="106" Height="106" BorderBrush="{Binding Detail.Accent}" BorderThickness="1" Padding="7" HorizontalAlignment="Left" Background="#0B1620"><Grid><TextBlock Text="◇" FontSize="45" Foreground="#6D8593" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Detail.Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Border>
                  <TextBlock Text="{Binding Detail.ArtworkLabel}" FontSize="8" Foreground="{StaticResource Muted}" Margin="0,7,0,18"/>
                  <TextBlock Text="{Binding Detail.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="22"/>
                  <TextBlock Text="{Binding Detail.Description}" Foreground="#B8C6CE" FontSize="12" Margin="0,12,0,20"/>
                  <Border BorderBrush="#415767" BorderThickness="0,1,0,0" Padding="0,15,0,0"><StackPanel><TextBlock Text="{Binding Detail.Status}" Foreground="{StaticResource Gold}" FontSize="10"/><TextBlock Text="{Binding Detail.Date}" FontSize="10" Margin="0,7,0,14"/><TextBlock Text="{Binding Detail.Rarity}" FontSize="11"/><TextBlock Text="{Binding Detail.Hidden}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,15"/><TextBlock Text="API IDENTIFIER" Style="{StaticResource Eyebrow}" FontSize="8"/><TextBlock Text="{Binding Detail.ApiId}" FontFamily="Consolas" FontSize="10" Margin="0,6,0,18"/><Button Content="Preview this unlock" Command="{Binding PreviewDetailCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/><TextBlock Text="Confirmation is always required." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,9,0,0"/></StackPanel></Border>
                </StackPanel>
              </StackPanel></ScrollViewer></Border>
            </Grid>
          </Grid>
          <Border Style="{StaticResource Panel}" Background="#DB101E29" Visibility="{Binding IsInformation, Converter={StaticResource BoolVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
              <StackPanel Orientation="Horizontal" Visibility="{Binding IsAbout, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,24"><Image Source="Branding/mark.png" Width="96" Height="96" Margin="0,0,24,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Dragonmark" FontFamily="{StaticResource DisplayFont}" FontSize="36" Foreground="{StaticResource Gold}"/><TextBlock Text="YOUR ACHIEVEMENTS. A CLEARER VIEW." Style="{StaticResource Eyebrow}" Margin="0,8,0,0"/></StackPanel></StackPanel>
              <StackPanel Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding Idle}">
                <TextBlock Text="ATMOSPHERE &amp; ACCESSIBILITY" FontFamily="{StaticResource DisplayFont}" FontSize="22" Margin="0,0,0,20"/>
                <Border BorderBrush="#435C6B" BorderThickness="1" Padding="18" Margin="0,0,0,14" Background="#152632"><StackPanel><CheckBox Content="Reduce motion" IsChecked="{Binding ReduceMotion}"/><TextBlock Text="Disable fades. Windows animation preferences are always respected." Foreground="{StaticResource Muted}" FontSize="11" Margin="29,7,0,0"/></StackPanel></Border>
                <Border BorderBrush="#435C6B" BorderThickness="1" Padding="18" Margin="0,0,0,14" Background="#152632"><StackPanel><TextBlock Text="LOCAL BACKGROUND ARTWORK" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Gold}"/><TextBlock Text="{Binding ThemeDescription}" Margin="0,8,0,14"/><WrapPanel><Button Content="Choose local image" Command="{Binding ChooseArtworkCommand}" Style="{StaticResource QuietButton}"/><Button Content="Restore original mountains" Command="{Binding ResetArtworkCommand}" Style="{StaticResource QuietButton}"/></WrapPanel></StackPanel></Border>
                <CheckBox Content="Enable Advanced Mode (demo clearing only)" IsChecked="{Binding AdvancedMode}" Margin="0,4,0,24"/>
              </StackPanel>
              <TextBox Text="{Binding Information, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Background="Transparent" BorderBrush="Transparent" FontSize="12" Padding="2"/>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,14,0,11">
          <DockPanel Margin="0,0,0,9"><TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource Gold}" FontSize="11"/><TextBlock Text="{Binding ClearExplanation}" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
          <WrapPanel><Button Content="Select filtered locked" Command="{Binding SelectCommand}" Style="{StaticResource QuietButton}"/><Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" Style="{StaticResource QuietButton}"/><Button Content="Preview unlock" Command="{Binding UnlockCommand}" Style="{StaticResource PrimaryButton}" Padding="12,7" MinHeight="30" FontSize="11"/><Button Content="Preview clear" Command="{Binding ClearAchievementsCommand}" Style="{StaticResource QuietButton}"/><Button Content="Save preset" Command="{Binding SavePresetCommand}" Style="{StaticResource QuietButton}"/><Button Content="Load preset" Command="{Binding LoadPresetCommand}" Style="{StaticResource QuietButton}"/><Button Content="Export report" Command="{Binding ExportCommand}" Style="{StaticResource QuietButton}"/></WrapPanel>
          <DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="View results" Command="{Binding ResultsCommand}" Style="{StaticResource QuietButton}" Margin="12,0,0,0"/><TextBlock Text="{Binding BatchSummary}" Foreground="{StaticResource Gold}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
        </StackPanel>
        <Border Grid.Row="5" BorderBrush="#516574" BorderThickness="0,1,0,0" Padding="0,10,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Cancel read" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}" Margin="12,0,0,0"/><StackPanel><TextBlock Text="{Binding PhaseTitle}" Foreground="{StaticResource Gold}" FontSize="9" Margin="0,0,0,5"/><ProgressBar local:Motion.Pulsing="{Binding AnimateProgress}" IsIndeterminate="{Binding AnimateProgress}" Value="35" Height="2" Margin="0,0,0,6" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Message}" FontSize="10" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/></StackPanel></DockPanel></Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
