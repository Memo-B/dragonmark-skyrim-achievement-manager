<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Dragonmark</AssemblyName>
    <AssemblyTitle>Dragonmark - Skyrim Achievement Manager</AssemblyTitle>
    <ApplicationIcon>../../assets/branding/dragonmark.ico</ApplicationIcon>
    <RuntimeFrameworkVersion Condition="'$(SelfContained)' == 'true'">10.0.14</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dragonmark.Core/Dragonmark.Core.csproj" />
    <ProjectReference Include="../Dragonmark.Steam/Dragonmark.Steam.csproj" />
    <ProjectReference Include="../Dragonmark.Infrastructure/Dragonmark.Infrastructure.csproj" />
    <Resource Include="../../assets/branding/mark.png" Link="Branding/mark.png" />
    <Resource Include="../../assets/fonts/Cinzel.ttf" Link="Fonts/Cinzel.ttf" />
    <None Include="../../steam_appid.txt" Link="steam_appid.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../native/steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../native/steam_api64.dll') and '$(IncludeSteamNative)' != 'false'" />
  </ItemGroup>
</Project>
